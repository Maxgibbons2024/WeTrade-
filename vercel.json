{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/iclosed/sync.js": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/fathom/sync",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/iclosed/sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/segmetrics/sync",
      "schedule": "0 6 * * *"
    }
  ]
}
